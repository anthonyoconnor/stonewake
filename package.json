{
  "name": "dwarven-stronghold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.tests.json",
    "verify": "node scripts/verify.mjs",
    "verify:browser": "node scripts/browser-smoke.mjs",
    "test:watch": "node scripts/verify.mjs --watch",
    "format": "prettier --write",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
